# Lumora Frontend — environment variables
# Copy this file to .env.local and fill in the values.
#
# NEXT_PUBLIC_API_URL — Base URL of the Lumora backend (no trailing slash).
#   Example: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8010

# NEXT_PUBLIC_API_KEY — API key sent as X-API-Key on every backend request.
#   This is a single-user, personal tool; the key is set once at build/dev time.
#   It is NOT exposed as a UI input field.
#   Must match the API_KEY configured in the backend's .env.
NEXT_PUBLIC_API_KEY=your-api-key-here
