# --- Required: external API keys ---
COHERE_API_KEY=
GROQ_API_KEY=

# --- Required: API auth ---
# Value clients must send in the X-API-Key header. SECRET_KEY is accepted as a fallback
# if API_KEY is unset, but a dedicated key is recommended.
API_KEY=
# SECRET_KEY=

# --- Optional: infra ---
QDRANT_URL=http://localhost:6333

# --- Optional: API limits (defaults shown) ---
MAX_REPO_SIZE_MB=500
RATE_LIMIT_PER_MINUTE=20
QUERY_TIMEOUT_SECONDS=30
